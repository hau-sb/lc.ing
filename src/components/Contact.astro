---
// src/components/Contact.astro
---

<style>
  section {
    padding: var(--spacing-3xl) var(--spacing-lg);
    background-color: var(--color-white);
  }

  .container {
    max-width: 700px;
    margin: 0 auto;
  }

  h2 {
    text-align: center;
    margin-bottom: var(--spacing-md);
    color: var(--color-navy);
    font-size: 2.2rem;
  }

  .subtitle {
    text-align: center;
    color: #888;
    margin-bottom: var(--spacing-2xl);
    font-size: 1.05rem;
  }

  form {
    background-color: var(--color-light-gray);
    padding: var(--spacing-2xl);
    border-radius: 0;
    border-left: 4px solid var(--color-cyan);
  }

  .form-group {
    margin-bottom: var(--spacing-lg);
  }

  label {
    display: block;
    font-weight: 600;
    margin-bottom: var(--spacing-sm);
    color: var(--color-navy);
    font-size: 0.95rem;
  }

  input,
  select,
  textarea {
    width: 100%;
    padding: 0.85rem;
    border: 1px solid #e0e0e0;
    border-radius: 0;
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--color-charcoal);
    transition: all 0.2s ease;
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--color-cyan);
    box-shadow: 0 0 0 3px rgba(0, 188, 212, 0.1);
  }

  textarea {
    resize: vertical;
    min-height: 160px;
  }

  button {
    width: 100%;
    background-color: var(--color-orange);
    color: white;
    padding: 1rem;
    font-weight: 600;
    font-size: 1rem;
    border: none;
    border-radius: 0;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  button:hover {
    background-color: #e55a24;
    transform: translateY(-2px);
  }

  button:focus-visible {
    outline: 2px solid var(--color-cyan);
    outline-offset: 2px;
  }

  .form-message {
    padding: var(--spacing-md);
    margin-top: var(--spacing-md);
    border-radius: 0;
    text-align: center;
    display: none;
    font-weight: 600;
  }

  .form-message.show {
    display: block;
  }

  .form-message.success {
    background-color: #e8f5e9;
    color: #2e7d32;
    border-left: 4px solid #4caf50;
  }

  .form-message.error {
    background-color: #ffebee;
    color: #c62828;
    border-left: 4px solid #f44336;
  }

  @media (max-width: 640px) {
    form {
      padding: var(--spacing-xl);
    }
  }
</style>

<section id="contact">
  <div class="container">
    <h2>¿Tienes preguntas?</h2>
    <p class="subtitle">Envíame un mensaje y te responderé en breve.</p>
    <form name="contact" method="POST">
      <input type="hidden" name="form-name" value="contact" />

      <div class="form-group">
        <label for="name">Nombre completo</label>
        <input type="text" id="name" name="name" required />
      </div>

      <div class="form-group">
        <label for="email">Correo electrónico</label>
        <input type="email" id="email" name="email" required />
      </div>

      <div class="form-group">
        <label for="type">Tipo de consulta</label>
        <select id="type" name="type" required>
          <option value="">-- Selecciona --</option>
          <option value="consulta">Consulta general</option>
          <option value="pregunta">Pregunta específica</option>
          <option value="requerimiento">Requerimiento de proceso</option>
          <option value="otro">Otro</option>
        </select>
      </div>

      <div class="form-group">
        <label for="message">Mensaje</label>
        <textarea id="message" name="message" required></textarea>
      </div>

      <button type="submit">Enviar mensaje</button>

      <div class="form-message success" id="successMessage">
        ¡Mensaje enviado! Te responderé pronto.
      </div>
      <div class="form-message error" id="errorMessage">
        Hubo un error. Por favor intenta nuevamente.
      </div>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector('form');
  const successMessage = document.getElementById('successMessage');
  const errorMessage = document.getElementById('errorMessage');

  form?.addEventListener('submit', (e) => {
    // Vercel Forms maneja el envío automáticamente
    // Aquí puedes agregar validación adicional si necesitas
  });
</script>
