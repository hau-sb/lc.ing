---
// src/components/Services.astro
import services from '../data/services.json';
---

<style>
  section {
    padding: var(--spacing-3xl) var(--spacing-lg);
    background-color: var(--color-white);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  h2 {
    margin-bottom: var(--spacing-2xl);
    text-align: center;
    color: var(--color-navy);
    font-size: 2.2rem;
  }

  .circular-process {
    position: relative;
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    aspect-ratio: 1.5;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .center-badge {
    position: absolute;
    width: 100px;
    height: 100px;
    background: linear-gradient(135deg, var(--color-cyan) 0%, #0097a7 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: white;
    font-weight: 700;
    font-size: 0.9rem;
    z-index: 10;
    box-shadow: 0 8px 24px rgba(0, 188, 212, 0.25);
  }

  .services-circle {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .service-item {
    position: absolute;
    width: 140px;
    text-align: center;
  }

  .service-item:nth-child(1) {
    top: 2%;
    left: 50%;
    transform: translateX(-50%);
  }

  .service-item:nth-child(2) {
    top: 18%;
    right: 8%;
  }

  .service-item:nth-child(3) {
    top: 65%;
    right: 8%;
  }

  .service-item:nth-child(4) {
    bottom: 2%;
    left: 50%;
    transform: translateX(-50%);
  }

  .service-item:nth-child(5) {
    top: 65%;
    left: 8%;
  }

  .service-item:nth-child(6) {
    top: 18%;
    left: 8%;
  }

  .step-badge {
    display: inline-block;
    background: linear-gradient(135deg, var(--color-orange) 0%, #e55a24 100%);
    color: white;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    text-align: center;
    line-height: 2.5rem;
    font-weight: 700;
    font-size: 0.95rem;
    margin-bottom: var(--spacing-sm);
    box-shadow: 0 4px 12px rgba(255, 107, 53, 0.2);
  }

  .service-item h3 {
    font-size: 1rem;
    margin-bottom: var(--spacing-xs);
    color: var(--color-navy);
    font-weight: 700;
  }

  .service-item p {
    font-size: 0.85rem;
    color: #666;
    line-height: 1.5;
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .circular-process {
      max-width: 100%;
      aspect-ratio: auto;
      height: auto;
      display: block;
      padding: var(--spacing-lg) 0;
    }

    .services-circle {
      position: static;
      height: auto;
    }

    .service-item {
      position: static !important;
      width: 100%;
      margin-bottom: var(--spacing-lg);
      transform: none !important;
      padding: var(--spacing-md);
      background-color: var(--color-light-gray);
      border-radius: 0;
      border-left: 4px solid var(--color-cyan);
    }

    .center-badge {
      display: none;
    }
  }
</style>

<section id="services">
  <div class="container">
    <h2>El Proceso</h2>
    <div class="circular-process">
      <div class="center-badge">Flujo Continuo</div>
      <svg style="position: absolute; width: 100%; height: 100%; top: 0; left: 0;">
        <circle cx="50%" cy="50%" r="40%" fill="none" stroke="#5a7d6f" stroke-width="1" opacity="0.2" />
        <path d="M 50% 10% Q 80% 30%, 90% 55%" stroke="#5a7d6f" stroke-width="1.5" fill="none" opacity="0.3" marker-end="url(#arrowhead)" />
        <path d="M 90% 55% Q 80% 80%, 50% 90%" stroke="#5a7d6f" stroke-width="1.5" fill="none" opacity="0.3" marker-end="url(#arrowhead)" />
        <path d="M 50% 90% Q 20% 80%, 10% 55%" stroke="#5a7d6f" stroke-width="1.5" fill="none" opacity="0.3" marker-end="url(#arrowhead)" />
        <path d="M 10% 55% Q 20% 30%, 50% 10%" stroke="#5a7d6f" stroke-width="1.5" fill="none" opacity="0.3" marker-end="url(#arrowhead)" />
        <defs>
          <marker id="arrowhead" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
            <polygon points="0 0, 10 3, 0 6" fill="#5a7d6f" opacity="0.5" />
          </marker>
        </defs>
      </svg>
      <div class="services-circle">
        {services.map((service) => (
          <div class="service-item">
            <div class="step-badge">{service.step}</div>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
