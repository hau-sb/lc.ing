---
// src/components/Header.astro
---

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-beige);
    border-bottom: 1px solid rgba(90, 125, 111, 0.1);
    padding: var(--spacing-md) var(--spacing-lg);
  }

  .header-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    font-weight: 700;
    font-size: 1.5rem;
    color: var(--color-musgo);
  }

  nav {
    display: flex;
    gap: var(--spacing-lg);
    align-items: center;
  }

  nav a {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-dark);
  }

  .cta {
    background-color: var(--color-musgo);
    color: white !important;
    padding: 0.6rem 1.2rem;
    border-radius: 0.25rem;
    font-weight: 500;
  }

  .cta:hover {
    background-color: #4a6d5f;
  }

  @media (max-width: 768px) {
    nav {
      flex-direction: column;
      gap: var(--spacing-md);
      text-align: center;
    }
  }
</style>

<header>
  <div class="header-container">
    <a href="#" class="logo">LCIng</a>
    <nav>
      <a href="#about">Sobre mí</a>
      <a href="#services">Servicios</a>
      <a href="#testimonials">Testimonios</a>
      <a href="#contact" class="cta">Contactar</a>
    </nav>
  </div>
</header>
