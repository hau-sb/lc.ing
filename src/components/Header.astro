---
// src/components/Header.astro
---

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-white);
    border-bottom: 1px solid var(--color-light-gray);
    padding: var(--spacing-md) var(--spacing-lg);
    box-shadow: 0 1px 3px rgba(26, 58, 74, 0.05);
  }

  .header-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    display: flex;
    align-items: center;
    transition: opacity 0.2s ease;
  }

  .logo:hover {
    opacity: 0.85;
  }

  .logo img {
    height: 45px;
    width: auto;
  }

  nav {
    display: flex;
    gap: var(--spacing-xl);
    align-items: center;
  }

  nav a {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-charcoal);
    position: relative;
  }

  nav a::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--color-cyan);
    transition: width 0.2s ease;
  }

  nav a:hover::after {
    width: 100%;
  }

  .cta {
    background-color: var(--color-orange);
    color: white !important;
    padding: 0.7rem 1.8rem;
    border-radius: 0;
    font-weight: 600;
    font-size: 0.9rem;
    transition: all 0.2s ease;
  }

  .cta:hover {
    background-color: #e55a24;
  }

  .cta::after {
    display: none;
  }

  @media (max-width: 768px) {
    nav {
      display: none;
    }
  }
</style>

<header>
  <div class="header-container">
    <a href="#" class="logo">
      <img src="/logo.png" alt="LCIng Logo" />
    </a>
    <nav>
      <a href="#about">Sobre mí</a>
      <a href="#services">Servicios</a>
      <a href="#testimonials">Testimonios</a>
      <a href="#contact" class="cta">Contactar</a>
    </nav>
  </div>
</header>
