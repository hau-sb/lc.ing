---
// src/components/Testimonials.astro
import testimonials from '../data/testimonials.json';

const renderStars = (rating: number) => {
  return '★'.repeat(rating) + '☆'.repeat(5 - rating);
};
---

<style>
  section {
    padding: var(--spacing-3xl) var(--spacing-lg);
    background: linear-gradient(180deg, var(--color-white) 0%, var(--color-light-gray) 100%);
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
  }

  h2 {
    text-align: center;
    margin-bottom: var(--spacing-2xl);
    color: var(--color-navy);
    font-size: 2.2rem;
  }

  .testimonials-carousel {
    position: relative;
    overflow: hidden;
  }

  .testimonials-track {
    display: flex;
    gap: var(--spacing-lg);
    animation: scroll 25s linear infinite;
  }

  @keyframes scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-100%); }
  }

  .testimonials-track:hover {
    animation-play-state: paused;
  }

  .testimonial-card {
    flex: 0 0 calc(33.333% - 0.67rem);
    background-color: white;
    padding: var(--spacing-lg);
    border-radius: 0;
    border-left: 4px solid var(--color-cyan);
    min-height: 260px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 4px 12px rgba(26, 58, 74, 0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .testimonial-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(26, 58, 74, 0.12);
  }

  .testimonial-text {
    font-size: 0.95rem;
    color: var(--color-charcoal);
    line-height: 1.7;
    margin-bottom: var(--spacing-md);
  }

  .testimonial-author {
    border-top: 1px solid var(--color-light-gray);
    padding-top: var(--spacing-md);
  }

  .author-name {
    font-weight: 700;
    color: var(--color-navy);
    font-size: 0.95rem;
  }

  .author-profession {
    font-size: 0.8rem;
    color: #999;
    margin-top: 0.25rem;
  }

  .stars {
    color: var(--color-orange);
    font-size: 1rem;
    margin: var(--spacing-sm) 0;
    letter-spacing: 0.3rem;
  }

  @media (max-width: 768px) {
    .testimonial-card {
      flex: 0 0 calc(50% - 0.5rem);
      min-height: 240px;
    }
  }

  @media (max-width: 480px) {
    .testimonial-card {
      flex: 0 0 100%;
    }
  }
</style>

<section id="testimonials">
  <div class="container">
    <h2>Lo que dicen nuestros clientes</h2>
    <div class="testimonials-carousel">
      <div class="testimonials-track">
        {testimonials.map((testimonial) => (
          <div class="testimonial-card">
            <p class="testimonial-text">"{testimonial.text}"</p>
            <div class="testimonial-author">
              <div class="stars">{renderStars(testimonial.rating)}</div>
              <div class="author-name">{testimonial.name}</div>
              <div class="author-profession">{testimonial.profession}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
